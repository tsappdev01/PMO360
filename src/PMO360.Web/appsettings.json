{
  "//Logging": "Microsoft.Extensions.Hosting.Internal.Host is silenced because it logs a startup failure with its stack trace, and PMO360 prints its own message for those. It logs nothing else.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Extensions.Hosting.Internal.Host": "None"
    }
  },
  "AllowedHosts": "*",

  "Authentication": {
    "EnableSso": true,

    "//": "With EnableSso false, nobody signs in: everyone is LocalUser and the portal opens on the dashboard. Development and demonstration only. Outside Development it also needs AllowSsoDisabledOutsideDevelopment, or the portal refuses to start.",
    "AllowSsoDisabledOutsideDevelopment": false,

    "LocalUser": {
      "DisplayName": "Local Developer",
      "Email": "local.developer@localhost",
      "ObjectId": "00000000-0000-0000-0000-00000000dev1",
      "Roles": [ "Management", "PmoAdministrator", "ProjectManager", "ProjectOwner", "Consultant", "ItSupport" ]
    }
  },

  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "dubaiinvestments.com",
    "TenantId": "<tenant-guid>",
    "ClientId": "<app-registration-client-id>",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },

  "ConnectionStrings": {
    "PmoDatabase": "Server=tcp:<sql-server>.database.windows.net,1433;Initial Catalog=PMO360;Authentication=Active Directory Default;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },

  "Portal": {
    "ApplicationName": "PMO360",
    "Tagline": "Project Management Office Portal",
    "TimeZone": "Asia/Dubai",
    "UpdateCycleDays": 7,
    "UpdateEscalationDays": 14,
    "MilestoneReminderDays": 7,
    "UpcomingMilestoneWindowDays": 14,
    "ListPageSize": 50,
    "DashboardProjectRows": 8,
    "FinancialYearStartMonth": 1
  },

  "Notifications": {
    "Enabled": true,
    "SenderAddress": "pmo@dubaiinvestments.com",
    "PmoAddress": "pmo@dubaiinvestments.com",
    "ManagementDistributionList": "pmo-management@dubaiinvestments.com",
    "DigestDay": "Monday",
    "DigestTime": "08:00",
    "ReminderSweepTime": "07:00",
    "PortalBaseUrl": "https://pmo360.dubaiinvestments.com"
  },

  "//Storage": "Provider is where document bytes live: Blob (Azure Blob Storage), Database (SQL Server, pmo.AttachmentContent - needs db/017_attachment_content.sql) or None. The catalogue row in pmo.Attachment is written either way, so the provider can be changed without a schema change.",
  "Storage": {
    "Provider": "Blob",
    "ServiceUri": "https://<storage-account>.blob.core.windows.net",
    "ContainerName": "project-documents",
    "MaxUploadMegabytes": 20
  },

  "Authorization": {
    "TrustAppRoleClaims": true,
    "RoleGroups": {
      "Management": [ "<entra-group-object-id>" ],
      "PmoAdministrator": [ "<entra-group-object-id>" ],
      "ProjectManager": [ "<entra-group-object-id>" ],
      "ProjectOwner": [ "<entra-group-object-id>" ],
      "Consultant": [ "<entra-group-object-id>" ],
      "ItSupport": [ "<entra-group-object-id>" ]
    }
  }
}
